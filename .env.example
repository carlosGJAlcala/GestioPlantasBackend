# Copia este fichero a .env (está en .gitignore) y arranca con:
#   set -a; . ./.env; set +a; ./mvnw spring-boot:run
# En Azure: App Service > Configuración > Variables de entorno (mismos nombres).
# PostgreSQL de la Raspberry (bd/montar-bd-raspberry.sh crea el usuario y te da la clave)
DB_URL=jdbc:postgresql://192.168.1.33:5432/huertodb
DB_USER=huerto
DB_PASSWORD=cambia-esto
# Para volver a la BD MySQL antigua: DB_URL=jdbc:mysql://..., DB_MIGRAR=false, DB_VALIDAR=none
DB_MIGRAR=true
DB_VALIDAR=validate
MAIL_USERNAME=huertouah@gmail.com
# Contraseña de aplicación NUEVA de Gmail (la anterior estaba en el repo: revócala)
MAIL_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_HOURS=24
# openssl rand -hex 24  — la misma clave va en HuertoEsp32/Huertoesp32/secretos.h (DEVICE_KEY)
DEVICE_API_KEY=
# S2: coste de BCrypt (10 por defecto) y conversión al arrancar de las contraseñas antiguas (SHA-256 sin sal)
CONTRASENAS_COSTE=10
CONTRASENAS_MIGRAR=true
# S8b: plazo para usar la contraseña temporal que pone el admin (ISO-8601: P3D = 3 días)
CONTRASENA_TEMPORAL_VALIDEZ=P3D
CORS_ORIGINS=http://localhost:3000
# Alertas por correo (usan MAIL_*; si MAIL_PASSWORD está vacía solo se ven en el panel)
ALERTAS_ACTIVAS=true
ALERTAS_INTERVALO=PT5M
ALERTAS_ESPERA_AVISO=PT30M
ALERTAS_ESPERA_CIERRE=PT30M
# S6: límite de intentos de login (fallos por usuario+IP, fallos por IP, ventana y bloqueo inicial)
LOGIN_INTENTOS=5
LOGIN_INTENTOS_IP=20
LOGIN_VENTANA=PT15M
LOGIN_BLOQUEO=PT15M
